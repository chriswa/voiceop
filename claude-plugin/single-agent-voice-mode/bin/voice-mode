#!/bin/bash
# voice-mode — Claude Code's voice mode controls, from the single-agent-voice-mode
# plugin (on the Bash tool's PATH while the plugin is enabled). Talks to Voice
# Operator's loopback API (/v1/voice-mode/…); Voice Operator does the rest.
#
#   voice-mode start [trigger] [voice]   attach this Claude Code session
#   voice-mode stop                      detach (voice mode off)
#   voice-mode status                    what voice mode is doing
#   voice-mode say 'words'               say something now, mid-turn
#   voice-mode say <<'EOF' … EOF         the same, the words on stdin
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../scripts/lib.sh
source "$here/../scripts/lib.sh"

usage() {
    sed -n '4,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

session="${CLAUDE_CODE_SESSION_ID:-}"
command="${1:-status}"
shift 2>/dev/null

if ! vo_url >/dev/null; then
    echo "Voice Operator isn't running, so voice mode can't work. Start Voice Operator (it lives in the menu bar) and try again." >&2
    exit 1
fi
if [ "$(vo_api_version)" -lt "$VO_API_REQUIRED" ]; then
    echo "This Voice Operator is too old for voice mode (needs API $VO_API_REQUIRED, has $(vo_api_version)). Update Voice Operator, then try again." >&2
    exit 1
fi

case "$command" in
start)
    if [ -z "$session" ]; then
        echo "voice-mode start must run inside a Claude Code session (no CLAUDE_CODE_SESSION_ID)." >&2
        exit 1
    fi
    trigger="${1:-}"
    voice="${2:-}"
    out=$(vo_post /attach --data-urlencode "session_id=$session" --data-urlencode "claude_pid=$(claude_pid)" \
        --data-urlencode "cwd=${CLAUDE_PROJECT_DIR:-$PWD}" --data-urlencode "trigger=$trigger" \
        --data-urlencode "voice=$voice")
    code=$?
    if [ $code -ne 0 ]; then
        echo "Voice mode could not start: $(json_field "$out" detail)" >&2
        exit 1
    fi
    word=$(json_field "$out" trigger)
    replaced=$(json_field "$out" replaced)
    echo "Voice mode is ON, attached to this session. Hands-free is listening on the Mac's microphone; the trigger word is \"$word\"."
    [ -n "$replaced" ] && echo "(It was attached to another session, $replaced, which no longer has it.)"
    echo
    cat "$here/../voice-mode.md"
    ;;
stop)
    out=$(vo_post /detach --data-urlencode "session_id=$session")
    code=$?
    if [ $code -ne 0 ]; then
        echo "Voice mode is attached to another session ($(json_field "$out" project)); left as it is." >&2
        exit 1
    fi
    if [ "$(json_field "$out" detached)" = "true" ]; then
        echo "Voice mode is OFF. Your replies are no longer spoken; answer in text from here on."
    else
        echo "Voice mode was not on."
    fi
    ;;
status)
    out=$(curl -sS --max-time 5 "$(vo_url)/v1/voice-mode")
    if [ "$(json_field "$out" attached)" != "true" ]; then
        echo "Voice mode is off."
    elif [ "$(json_field "$out" session_id)" = "$session" ]; then
        echo "Voice mode is ON for this session: trigger word \"$(json_field "$out" trigger)\", hands-free $(json_field "$out" phase), sound going to $(json_field "$out" route)."
    else
        echo "Voice mode is on, but for another session ($(json_field "$out" project))."
    fi
    ;;
say)
    if [ $# -gt 0 ]; then text="$*"; else text=$(cat); fi
    out=$(vo_post /say --data-urlencode "session_id=$session" --data-urlencode "text=$text")
    if [ $? -ne 0 ]; then
        echo "Not said: $(json_field "$out" detail)" >&2
        exit 1
    fi
    echo "Said."
    ;;
help|-h|--help)
    usage
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
