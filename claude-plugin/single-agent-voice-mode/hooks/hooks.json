{
  "description": "Single-agent voice mode: speaks the agent's replies and hands it what the user says, through Voice Operator. Every hook exits at once unless voice mode is attached.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "stop"
            ],
            "asyncRewake": true,
            "timeout": 86400,
            "rewakeSummary": "Voice mode: the user spoke",
            "rewakeMessage": "Voice mode \u2014 this is the user talking to you. They turned voice mode on themselves (/single-agent-voice-mode:start), and the plugin's Stop hook delivers their spoken words this way:"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "post-tool-use"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "pre-tool-use"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "user-prompt-submit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "session-end"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook",
            "args": [
              "notification"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
